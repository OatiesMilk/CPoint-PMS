# Copy to .env and adjust. Every variable the app reads is listed here.

# --- Database ---
# Local dev (Next.js on your machine, PostgreSQL in Docker via `npm run db:up`):
DATABASE_URL="postgresql://cpoint:cpoint_dev_password@localhost:5432/cpoint_pms?schema=public"
# Used by docker-compose to create the database (keep in sync with DATABASE_URL):
POSTGRES_USER=cpoint
POSTGRES_PASSWORD=cpoint_dev_password
POSTGRES_DB=cpoint_pms
# Host port for PostgreSQL (change if 5432 is taken on your machine):
DB_PORT=5432

# --- Auth ---
# Secret that signs session tokens. REQUIRED. Generate one per machine:
#   openssl rand -base64 32      (or: npx auth secret)
AUTH_SECRET=
# Trust the Host header so the app works when opened by LAN IP (e.g. http://192.168.1.20:3000).
AUTH_TRUST_HOST=true

# First System Admin, created on startup only if no active admin exists.
# Sign in with it, then create real accounts in Admin → Users (Phase 6).
BOOTSTRAP_ADMIN_EMAIL=admin@cpoint.local
BOOTSTRAP_ADMIN_PASSWORD=
# Demo accounts, one per role (manager@, inspector@, admin@, constructor@cpoint.local).
# For development and the capstone demo only. Turn off for real use.
SEED_DEMO_USERS=true
DEMO_USER_PASSWORD=
# A realistic past week of production (batches, scans, repairs, stock) for the panel demo.
# Runs once in the background on start, only when the database has no batches yet.
# Needs SEED_DEMO_USERS=true. Same as `npm run demo:seed`. Leave off for real use.
SEED_DEMO_WEEK=false

# --- App ---
# Host port for the app in `docker compose up`:
APP_PORT=3000
APP_TIMEZONE=Asia/Manila
LOG_LEVEL=info
# Where scan images are stored (a named volume in Docker):
UPLOADS_DIR=./storage/uploads

# --- Camera simulator (npm run cv:simulate) ---
# Create a device token with `npm run cv:token` (or Admin → API tokens) and paste it here.
CV_DEVICE_TOKEN=
CV_BASE_URL=http://localhost:3000

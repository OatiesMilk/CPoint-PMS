// CPoint Product Monitoring System — database schema.
// Conventions (D-018): UUIDv7 ids, snake_case tables via @@map, camelCase columns, every FK indexed,
// no hard deletes for people/production data. Only src/server/models/** may import the client.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── enums ─────────────
enum Role {
  FLOOR_MANAGER
  QUALITY_INSPECTOR
  SYSTEM_ADMIN
  SHOE_CONSTRUCTOR
}

enum Stage {
  PREPARATION
  UPPER_MAKING
  SOLEING
  FINISHING
}

enum BatchStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Verdict {
  PASS
  REWORK
  REJECT
  NEEDS_REVIEW // only as aiVerdict (unknown class key); finalVerdict is PASS/REWORK/REJECT
}

enum ScanStatus {
  PENDING_REVIEW
  DECIDED
}

enum ScanSource {
  SIMULATOR
  PHONE
  WEBCAM
  DEDICATED_CAMERA
}

enum ReworkStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED // its scan's decision was overridden
}

enum SalvageStatus {
  AVAILABLE
  ASSIGNED
  DISCARDED
  CANCELLED // its scan's decision was overridden
}

enum InventoryCategory {
  LEATHER_ROLL
  NAILS
  ADHESIVE
  THREAD
  EQUIPMENT
  OTHER
}

enum MovementType {
  IN
  OUT
  ADJUST
}

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  RECEIVED
}

enum ActorType {
  USER
  DEVICE
  SYSTEM
}

// ───────────── people & access ─────────────
model User {
  id                     String    @id @default(uuid(7)) @db.Uuid
  name                   String
  email                  String    @unique // stored lower-cased
  passwordHash           String
  role                   Role
  isActive               Boolean   @default(true)
  mustChangePassword     Boolean   @default(false) // set by admin reset (Phase 6)
  /// Sessions signed in before this are ended (password reset or change, D-024).
  sessionsValidFrom      DateTime?
  failedLoginCount       Int       @default(0)
  lockedUntil            DateTime?
  lastLoginAt            DateTime?
  /// May ask for leather rolls in purchase requests. Shoe Constructors only (D-031); every
  /// constructor can request the other materials.
  canRequestLeatherRolls Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  batchesCreated    Batch[]                 @relation("BatchCreatedBy")
  stageLogsStarted  BatchStageLog[]         @relation("StageStartedBy")
  stageLogsEnded    BatchStageLog[]         @relation("StageEndedBy")
  scanDecisions     Scan[]                  @relation("ScanDecidedBy")
  reworkCompleted   ReworkTicket[]          @relation("ReworkCompletedBy")
  salvageHandled    SalvageItem[]           @relation("SalvageHandledBy")
  movements         InventoryMovement[]
  apiTokensCreated  ApiToken[]
  cvSettingsUpdates CvSettings[]
  auditLogs         AuditLog[]
  revokedSessions   SessionRevocation[]
  purchaseRequests  PurchaseRequest[]       @relation("PurchaseRequestedBy")
  purchaseDecisions PurchaseRequest[]       @relation("PurchaseDecidedBy")
  purchaseEvents    PurchaseRequestEvent[]
  purchaseRemarks   PurchaseRequestRemark[]

  @@index([role, isActive])
  @@map("users")
}

/// A signed-out session (D-025 fix): its JWT `sid` is refused even if a stale cookie comes back.
/// Rows are only needed until the token would have expired anyway; old ones are deleted on sign-out.
model SessionRevocation {
  sid       String   @id
  userId    String   @db.Uuid
  revokedAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session_revocations")
}

model ApiToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String // e.g. "Preparation phone camera"
  tokenPrefix String // first 8 chars, shown in the admin UI to identify a token
  tokenHash   String    @unique // SHA-256 of the token; the plain token is shown once
  scopes      String[] // e.g. ["scans:create"]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())

  createdBy User       @relation(fields: [createdById], references: [id])
  scans     Scan[]
  auditLogs AuditLog[]

  @@index([createdById])
  @@map("api_tokens")
}

model AuditLog {
  id           String    @id @default(uuid(7)) @db.Uuid
  actorType    ActorType
  actorUserId  String?   @db.Uuid
  actorTokenId String?   @db.Uuid
  action       String // "user.login", "batch.create", "scan.override", ...
  entity       String // "User", "Batch", "Scan", ...
  entityId     String?
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  actorUser  User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorToken ApiToken? @relation(fields: [actorTokenId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorUserId])
  @@index([actorTokenId])
  @@index([action])
  @@map("audit_logs")
}

// ───────────── reference data ─────────────
model ShoeType {
  id        String  @id @default(uuid(7)) @db.Uuid
  code      String  @unique // "SCH", "TOP"
  name      String  @unique // "School Shoe", "Topsider"
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  batches        Batch[]
  componentTypes ComponentType[]

  @@map("shoe_types")
}

model Supplier {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String   @unique
  contactPerson String?
  phone         String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  batches Batch[]

  @@map("suppliers")
}

model ComponentType {
  id         String  @id @default(uuid(7)) @db.Uuid
  shoeTypeId String? @db.Uuid
  name       String
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)

  shoeType ShoeType? @relation(fields: [shoeTypeId], references: [id])

  @@index([shoeTypeId])
  @@map("component_types")
}

model DefectType {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique // YOLO class key: "cut", "hole", "abrasion", "dirt"
  label       String
  description String?
  isActive    Boolean  @default(true) // inactive types are ignored by the decision engine
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  detections Detection[]

  @@map("defect_types")
}

model CvSettings {
  id              Int      @id @default(1)
  rejectAtOrAbove Float    @default(0.9)
  reworkAtOrAbove Float    @default(0.6)
  /// The batch the single Preparation camera feeds (D-020). Null = oldest batch at Preparation.
  activeBatchId   String?  @db.Uuid
  updatedById     String?  @db.Uuid
  updatedAt       DateTime @updatedAt

  activeBatch Batch? @relation("CameraActiveBatch", fields: [activeBatchId], references: [id], onDelete: SetNull)
  updatedBy   User?  @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([activeBatchId])
  @@index([updatedById])
  @@map("cv_settings")
}

// ───────────── production ─────────────
model BatchSequence {
  year      Int @id
  lastValue Int @default(0)

  @@map("batch_sequences")
}

model Batch {
  id               String      @id @default(uuid(7)) @db.Uuid
  code             String      @unique
  rollCode         String
  supplierId       String?     @db.Uuid
  shoeTypeId       String      @db.Uuid
  receivedAt       DateTime    @db.Date
  targetQuotaPairs Int?
  status           BatchStatus @default(PLANNED)
  currentStage     Stage       @default(PREPARATION)
  notes            String?
  cancelledReason  String?
  createdById      String      @db.Uuid
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  supplier        Supplier?           @relation(fields: [supplierId], references: [id])
  shoeType        ShoeType            @relation(fields: [shoeTypeId], references: [id])
  createdBy       User                @relation("BatchCreatedBy", fields: [createdById], references: [id])
  stageLogs       BatchStageLog[]
  scans           Scan[]
  salvageOrigin   SalvageItem[]       @relation("SalvageOrigin")
  salvageAssigned SalvageItem[]       @relation("SalvageAssigned")
  cameraSettings  CvSettings[]        @relation("CameraActiveBatch")
  movements       InventoryMovement[]

  @@index([status, currentStage])
  @@index([supplierId])
  @@index([shoeTypeId])
  @@index([createdById])
  @@index([createdAt])
  @@map("batches")
}

model BatchStageLog {
  id          String    @id @default(uuid(7)) @db.Uuid
  batchId     String    @db.Uuid
  stage       Stage
  startedAt   DateTime  @default(now())
  endedAt     DateTime? // null = stage in progress (one open log per batch, enforced in service)
  startedById String    @db.Uuid
  endedById   String?   @db.Uuid
  isRollback  Boolean   @default(false)
  reason      String? // required when isRollback
  notes       String?

  batch     Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  startedBy User  @relation("StageStartedBy", fields: [startedById], references: [id])
  endedBy   User? @relation("StageEndedBy", fields: [endedById], references: [id])

  @@index([batchId, startedAt])
  @@index([stage, startedAt])
  @@index([startedById])
  @@index([endedById])
  @@map("batch_stage_logs")
}

// ───────────── computer vision ─────────────
model Scan {
  id                 String     @id @default(uuid(7)) @db.Uuid
  batchId            String     @db.Uuid
  sequence           Int // 1..n within the batch
  imagePath          String?
  imageMime          String?
  source             ScanSource
  modelVersion       String?
  deviceTokenId      String?    @db.Uuid
  aiVerdict          Verdict
  maxConfidence      Float?
  thresholdsSnapshot Json // { rejectAtOrAbove, reworkAtOrAbove } used for this decision
  finalVerdict       Verdict? // null while PENDING_REVIEW
  status             ScanStatus
  isOverride         Boolean    @default(false)
  overrideReason     String?
  decidedById        String?    @db.Uuid // null = decided automatically
  decidedAt          DateTime?
  capturedAt         DateTime   @default(now())
  createdAt          DateTime   @default(now())

  batch         Batch          @relation(fields: [batchId], references: [id], onDelete: Restrict)
  deviceToken   ApiToken?      @relation(fields: [deviceTokenId], references: [id], onDelete: SetNull)
  decidedBy     User?          @relation("ScanDecidedBy", fields: [decidedById], references: [id])
  detections    Detection[]
  reworkTickets ReworkTicket[]
  salvageItems  SalvageItem[]

  @@unique([batchId, sequence])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([finalVerdict])
  @@index([deviceTokenId])
  @@index([decidedById])
  @@map("scans")
}

model Detection {
  id             String  @id @default(uuid(7)) @db.Uuid
  scanId         String  @db.Uuid
  defectTypeId   String? @db.Uuid // null when the class key is unknown
  rawClassKey    String // exactly what the model sent
  isUnknownClass Boolean @default(false)
  confidence     Float
  x              Float // bounding box, fractions 0–1 of the image
  y              Float
  width          Float
  height         Float

  scan       Scan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  defectType DefectType? @relation(fields: [defectTypeId], references: [id])

  @@index([scanId])
  @@index([defectTypeId])
  @@map("detections")
}

model ReworkTicket {
  id            String       @id @default(uuid(7)) @db.Uuid
  scanId        String       @db.Uuid // one non-cancelled ticket per scan (service-enforced)
  status        ReworkStatus @default(OPEN)
  notes         String?
  openedAt      DateTime     @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  completedById String?      @db.Uuid
  cancelledAt   DateTime?

  scan        Scan  @relation(fields: [scanId], references: [id], onDelete: Cascade)
  completedBy User? @relation("ReworkCompletedBy", fields: [completedById], references: [id])

  @@index([scanId])
  @@index([status, openedAt])
  @@index([completedById])
  @@map("rework_tickets")
}

model SalvageItem {
  id              String        @id @default(uuid(7)) @db.Uuid
  scanId          String        @db.Uuid
  originBatchId   String        @db.Uuid
  status          SalvageStatus @default(AVAILABLE)
  assignedBatchId String?       @db.Uuid
  assignedAt      DateTime?
  discardedAt     DateTime?
  handledById     String?       @db.Uuid
  notes           String?
  createdAt       DateTime      @default(now())

  scan          Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  originBatch   Batch  @relation("SalvageOrigin", fields: [originBatchId], references: [id])
  assignedBatch Batch? @relation("SalvageAssigned", fields: [assignedBatchId], references: [id])
  handledBy     User?  @relation("SalvageHandledBy", fields: [handledById], references: [id])

  @@index([scanId])
  @@index([originBatchId])
  @@index([assignedBatchId])
  @@index([status])
  @@index([handledById])
  @@map("salvage_items")
}

// ───────────── inventory ─────────────
model InventoryItem {
  id             String            @id @default(uuid(7)) @db.Uuid
  sku            String            @unique
  name           String
  category       InventoryCategory
  unit           String // "roll", "box", "kg", "m"
  quantityOnHand Decimal           @default(0) @db.Decimal(12, 2) // changed only via movements
  reorderLevel   Decimal           @default(0) @db.Decimal(12, 2)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  movements    InventoryMovement[]
  requestLines PurchaseRequestLine[]

  @@index([category, isActive])
  @@map("inventory_items")
}

model InventoryMovement {
  id            String       @id @default(uuid(7)) @db.Uuid
  itemId        String       @db.Uuid
  type          MovementType
  quantityDelta Decimal      @db.Decimal(12, 2) // + for IN, - for OUT, either sign for ADJUST
  reason        String
  batchId       String?      @db.Uuid
  createdById   String       @db.Uuid
  createdAt     DateTime     @default(now())

  item         InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batch        Batch?                @relation(fields: [batchId], references: [id])
  createdBy    User                  @relation(fields: [createdById], references: [id])
  requestLines PurchaseRequestLine[]

  @@index([itemId, createdAt])
  @@index([batchId])
  @@index([createdById])
  @@map("inventory_movements")
}

// ───────────── procurement (D-029) ─────────────
model PurchaseRequestSequence {
  year      Int @id
  lastValue Int @default(0)

  @@map("purchase_request_sequences")
}

/// A Shoe Constructor asks for materials; the Floor Manager decides. Never edited after it's
/// submitted: cancel and send a new one. Why it's needed goes in the first remark (D-036).
model PurchaseRequest {
  id              String                @id @default(uuid(7)) @db.Uuid
  code            String                @unique // PR-2026-0001
  requestedById   String                @db.Uuid
  status          PurchaseRequestStatus @default(PENDING)
  /// Required. Urgency is worked out from it at read time and never stored (D-037).
  neededBy        DateTime              @db.Date
  decidedById     String?               @db.Uuid
  decidedAt       DateTime?
  rejectionReason String?
  approvalNote    String?
  receivedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  requestedBy User                    @relation("PurchaseRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?                   @relation("PurchaseDecidedBy", fields: [decidedById], references: [id])
  lines       PurchaseRequestLine[]
  events      PurchaseRequestEvent[]
  remarks     PurchaseRequestRemark[]

  @@index([status, createdAt])
  @@index([requestedById])
  @@index([decidedById])
  @@map("purchase_requests")
}

model PurchaseRequestLine {
  id                    String            @id @default(uuid(7)) @db.Uuid
  requestId             String            @db.Uuid
  inventoryItemId       String?           @db.Uuid // null: an item not in inventory yet
  itemName              String // copied from the item, or typed
  /// Copied from the item, or chosen for a typed one, so leather rolls are always recognised (D-031).
  category              InventoryCategory
  unit                  String
  quantity              Decimal           @db.Decimal(12, 2)
  note                  String?
  /// Stock when the request was made, so the Floor Manager sees why it was asked for.
  onHandAtRequest       Decimal?          @db.Decimal(12, 2)
  reorderLevelAtRequest Decimal?          @db.Decimal(12, 2)
  movementId            String?           @db.Uuid // the IN movement posted on receipt
  position              Int

  request  PurchaseRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item     InventoryItem?     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  movement InventoryMovement? @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@index([requestId])
  @@index([inventoryItemId])
  @@index([movementId])
  @@map("purchase_request_lines")
}

/// The request's timeline, shown to everyone who can see the request (the audit log is admin-only).
model PurchaseRequestEvent {
  id         String                 @id @default(uuid(7)) @db.Uuid
  requestId  String                 @db.Uuid
  fromStatus PurchaseRequestStatus? // null when submitted
  toStatus   PurchaseRequestStatus
  actorId    String                 @db.Uuid
  note       String?
  createdAt  DateTime               @default(now())

  request PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User            @relation(fields: [actorId], references: [id])

  @@index([requestId, createdAt])
  @@index([actorId])
  @@map("purchase_request_events")
}

/// Remarks are only ever added, never edited or deleted.
model PurchaseRequestRemark {
  id        String   @id @default(uuid(7)) @db.Uuid
  requestId String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  request PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User            @relation(fields: [authorId], references: [id])

  @@index([requestId, createdAt])
  @@index([authorId])
  @@map("purchase_request_remarks")
}

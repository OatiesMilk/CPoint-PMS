// CPoint Product Monitoring System — database schema.
// Conventions (D-018): UUIDv7 ids, snake_case tables via @@map, camelCase columns, every FK indexed,
// no hard deletes for people/production data. Only src/server/models/** may import the client.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── enums ─────────────
enum Role {
  FLOOR_MANAGER
  QUALITY_INSPECTOR
  SYSTEM_ADMIN
  SHOE_CONSTRUCTOR
}

/// A roll is captured shot by shot at Capture until all of it is in (Phase 26, D-095).
/// A roll's life since Phase 30E (D-112, D-113): added to its leather item by the Floor Manager with
/// its area (IN_STOCK), picked at Capture (OPEN), finished there and taken off stock (FINISHED), or
/// removed with a reason (CANCELLED). USED (Fully used at Finish batch) and RETURNED (Phase 30C)
/// remain for old rows only.
enum RollStatus {
  IN_STOCK
  OPEN
  FINISHED
  USED
  /// Sent back to the supplier on the Floor Manager's decision (Phase 30C, D-110, C-36).
  RETURNED
  CANCELLED
}

/// The Floor Manager's decision on a finished roll (Phase 30C, D-110, C-36).
enum ReturnDecision {
  RETURNED
  KEPT
}

/// A section is Pass or Reject, and the camera's verdict is final (Phase 25, D-093).
enum Verdict {
  PASS
  REJECT
}

/// What a found defect of a type means for the section (D-093): Usable leaves it Pass, Not
/// accepted rejects it. Data, set per defect type in Settings.
enum DefectOutcome {
  USABLE
  NOT_ACCEPTED
}

enum ScanSource {
  SIMULATOR
  PHONE
  WEBCAM
  DEDICATED_CAMERA
}

enum InventoryCategory {
  LEATHER_ROLL
  NAILS
  ADHESIVE
  THREAD
  EQUIPMENT
  OTHER
}

enum MovementType {
  IN
  OUT
  ADJUST
}

enum ActorType {
  USER
  DEVICE
  SYSTEM
}

// ───────────── people & access ─────────────
model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  name               String
  email              String    @unique // stored lower-cased
  passwordHash       String
  role               Role
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false) // set by admin reset (Phase 6)
  /// Sessions signed in before this are ended (password reset or change, D-024).
  sessionsValidFrom  DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  /// Has camera access: may start, capture and finish rolls at Capture on their phone. Shoe
  /// Constructors only, granted by the System Admin (D-075, Phase 26).
  canCapture         Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  rollsCreated      Roll[]               @relation("RollCreatedBy")
  rollsFinished     Roll[]               @relation("RollFinishedBy")
  rollsCancelled    Roll[]               @relation("RollCancelledBy")
  rollsStarted      Roll[]               @relation("RollStartedBy")
  rollsUsed         Roll[]               @relation("RollUsedBy")
  rollsDecided      Roll[]               @relation("RollReturnDecidedBy")
  movements         InventoryMovement[]
  apiTokensCreated  ApiToken[]
  cvSettingsUpdates CvSettings[]
  auditLogs         AuditLog[]
  revokedSessions   SessionRevocation[]
  attendanceTaken   AttendanceDay[]      @relation("AttendanceTakenBy")
  attendanceMarks   AttendanceMark[]
  schedulesSet      ProductionSchedule[]
  lunchBreaksSet    LunchBreak[]
  quotasSet         DailyQuota[]
  checkInsEntered   ProductionCheckIn[]  @relation("CheckInEnteredBy")
  checkInsCorrected ProductionCheckIn[]  @relation("CheckInCorrectedBy")
  stockUpdates      StockUpdate[]
  inventorySettings InventorySettings[]

  @@index([role, isActive])
  @@map("users")
}

/// A signed-out session (D-025 fix): its JWT `sid` is refused even if a stale cookie comes back.
/// Rows are only needed until the token would have expired anyway; old ones are deleted on sign-out.
model SessionRevocation {
  sid       String   @id
  userId    String   @db.Uuid
  revokedAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session_revocations")
}

model ApiToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String // e.g. "Preparation phone camera"
  tokenPrefix String // first 8 chars, shown in the admin UI to identify a token
  tokenHash   String    @unique // SHA-256 of the token; the plain token is shown once
  scopes      String[] // e.g. ["scans:create"]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())

  createdBy User       @relation(fields: [createdById], references: [id])
  scans     Scan[]
  auditLogs AuditLog[]

  @@index([createdById])
  @@map("api_tokens")
}

model AuditLog {
  id           String    @id @default(uuid(7)) @db.Uuid
  actorType    ActorType
  actorUserId  String?   @db.Uuid
  actorTokenId String?   @db.Uuid
  action       String // "user.login", "roll.create", "scan.override", ...
  entity       String // "User", "Roll", "Scan", ...
  entityId     String?
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  actorUser  User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorToken ApiToken? @relation(fields: [actorTokenId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorUserId])
  @@index([actorTokenId])
  @@index([action])
  @@map("audit_logs")
}

// ───────────── reference data ─────────────
model Supplier {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String   @unique
  contactPerson String?
  phone         String?
  notes         String?
  /// Short code in roll codes, LR-<code>-001 (Phase 30A, D-104): 2 to 6 capital letters or digits.
  code          String   @unique
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  rolls          Roll[]
  inventoryItems InventoryItem[]

  @@map("suppliers")
}

model DefectType {
  id          String        @id @default(uuid(7)) @db.Uuid
  key         String        @unique // YOLO class key: "cut", "hole", "abrasion", "dirt"
  label       String
  description String?
  isActive    Boolean       @default(true) // inactive types are ignored by the decision engine
  /// Usable or Not accepted once found (confidence ≥ CvSettings.foundAtOrAbove, D-093)
  outcome     DefectOutcome
  /// Not accepted from this length in inches (the box diagonal, D-106) and Usable below it
  /// (Phase 30C, C-37: cut 3). Null: no length limit, `outcome` applies.
  notAcceptedFromIn Float?
  /// Counts as this flat share of the roll instead of its box area (D-110: a cut from its length
  /// limit counts 1%). Null: counted by its box area.
  flatSharePct      Float?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  detections Detection[]

  @@map("defect_types")
}

model CvSettings {
  id               Int      @id @default(1)
  /// A detection counts as found from this confidence (D-053); below it, it counts for nothing.
  foundAtOrAbove   Float    @default(0.5)
  /// Show the early-model notice on the Camera page (D-055).
  earlyModelNotice Boolean  @default(true)
  /// A finished roll is marked Return to supplier when its defect share is more than this (C-9).
  returnSharePct   Float    @default(10)
  updatedById      String?  @db.Uuid
  updatedAt        DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("cv_settings")
}

// ───────────── production ─────────────
/// The yearly R-YYYY-NNNN numbers of Phases 26 to 29 (history; no new codes since Phase 30A).
model RollSequence {
  year      Int @id
  lastValue Int @default(0)

  @@map("batch_sequences")
}

/// The next number per roll-code prefix, e.g. "LR-MLT" (Phase 30A, D-104).
model RollCodeSequence {
  prefix    String @id
  lastValue Int    @default(0)

  @@map("roll_code_sequences")
}

/// One leather roll from a supplier (the table keeps its old name, D-095). Since Phase 30A
/// (D-104) the Floor Manager adds it to Inventory with its area; a Shoe Constructor picks it at
/// Capture, captures it shot by shot and finishes it; the QI ticks it Fully used at Finish batch.
model Roll {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// LR-MLT-001 since Phase 30A; R-YYYY-NNNN (Phases 26 to 29) and B-YYYY-NNNN rolls keep theirs
  code            String     @unique
  /// The number on the supplier's tag, optional.
  tagCode         String?    @map("rollCode")
  supplierId      String?    @db.Uuid // the leather item's supplier; older rolls may have none
  /// The leather item it belongs to (Phase 30A); null for rolls from before.
  itemId          String?    @db.Uuid
  /// Its area in square feet, from the stamp or the receipt (D-103); null for rolls from before.
  areaSqFt        Decimal?   @db.Decimal(8, 2)
  receivedAt      DateTime?  @db.Date
  status          RollStatus // always set by the service; no default (the enum value is new)
  /// Who added the record (the Floor Manager; before Phase 30A, who started it). Kept for the
  /// audit only, never shown or totalled per person (D-008).
  createdById     String     @db.Uuid
  /// Picked at Capture: when, and by whom (only to start the Roll dropdown on their roll, D-008).
  startedAt       DateTime?
  startedById     String?    @db.Uuid
  finishedAt      DateTime?
  finishedById    String?    @db.Uuid
  cancelledAt     DateTime?
  cancelledById   String?    @db.Uuid
  cancelledReason String?
  /// Ticked Fully used at Finish batch (Phase 30A): when, by whom (audit only) and in which batch.
  usedAt          DateTime?
  usedById        String?    @db.Uuid
  usedCheckInId   String?    @db.Uuid
  /// Worked out at Finish roll (Phase 30C, D-110): the defect area, the share of the entered area
  /// (flat shares included) and the limit then. Null when the roll couldn't be measured.
  defectAreaSqIn  Float?
  defectSharePct  Float?
  returnLimitPct  Float?
  /// Over the limit at Finish roll: Return to supplier, for the Floor Manager to decide.
  markedForReturn Boolean    @default(false)
  /// The Floor Manager's decision (C-36): returned on a date, or kept with a reason. Who decided
  /// is kept for the audit only (D-008).
  returnDecision    ReturnDecision?
  returnedOn        DateTime?  @db.Date
  returnNote        String?
  returnDecidedAt   DateTime?
  returnDecidedById String?    @db.Uuid
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  supplier    Supplier?           @relation(fields: [supplierId], references: [id])
  item        InventoryItem?      @relation(fields: [itemId], references: [id])
  createdBy   User                @relation("RollCreatedBy", fields: [createdById], references: [id])
  startedBy   User?               @relation("RollStartedBy", fields: [startedById], references: [id])
  finishedBy  User?               @relation("RollFinishedBy", fields: [finishedById], references: [id])
  cancelledBy User?               @relation("RollCancelledBy", fields: [cancelledById], references: [id])
  usedBy      User?               @relation("RollUsedBy", fields: [usedById], references: [id])
  returnDecidedBy User?           @relation("RollReturnDecidedBy", fields: [returnDecidedById], references: [id])
  usedCheckIn ProductionCheckIn?  @relation(fields: [usedCheckInId], references: [id])
  scans       Scan[]
  /// Its stock entries: added (+1), and fully used or removed (−1) since Phase 30A
  movements   InventoryMovement[]

  @@index([status, startedAt])
  @@index([status, startedById])
  @@index([itemId, status])
  @@index([supplierId])
  @@index([createdById])
  @@index([startedById])
  @@index([usedById])
  @@index([returnDecidedById])
  @@index([markedForReturn, returnDecision])
  @@index([usedCheckInId])
  @@index([finishedById])
  @@index([cancelledById])
  @@index([createdAt])
  @@map("batches")
}

// ───────────── computer vision ─────────────
model Scan {
  id                 String     @id @default(uuid(7)) @db.Uuid
  rollId             String     @map("batchId") @db.Uuid
  sequence           Int // 1..n within the roll
  imagePath          String?
  imageMime          String?
  source             ScanSource
  modelVersion       String?
  deviceTokenId      String?    @db.Uuid
  captureId          String?    @unique @db.Uuid // set by the camera; a retry returns the first scan (D-051)
  aiVerdict          Verdict
  maxConfidence      Float?
  thresholdsSnapshot Json // the rule in force: { foundAtOrAbove, outcomes } (older scans: thresholds, actions)
  finalVerdict       Verdict // always equal to aiVerdict since Phase 25: nobody changes it (D-093)
  /// The photo's size in pixels (EXIF turns applied) and the inches across its width from the
  /// phone's calibration (Phase 30C, A-18); widthIn is null when the phone wasn't calibrated.
  imageWidth         Int?
  imageHeight        Int?
  widthIn            Float?
  /// The union of the found defects counted by box area, in square inches (C-35, D-106).
  defectAreaSqIn     Float?
  /// The flat shares of the found defects counted that way, in percent (D-110).
  flatSharePct       Float?
  capturedAt         DateTime   @default(now())
  createdAt          DateTime   @default(now())

  roll        Roll        @relation(fields: [rollId], references: [id], onDelete: Restrict)
  deviceToken ApiToken?   @relation(fields: [deviceTokenId], references: [id], onDelete: SetNull)
  detections  Detection[]

  @@unique([rollId, sequence])
  @@index([createdAt])
  @@index([finalVerdict])
  @@index([deviceTokenId])
  @@map("scans")
}

model Detection {
  id           String  @id @default(uuid(7)) @db.Uuid
  scanId       String  @db.Uuid
  defectTypeId String? @db.Uuid // always set since D-108; nullable for old rows
  rawClassKey  String // exactly what the model sent
  confidence   Float
  x            Float // bounding box, fractions 0–1 of the image
  y            Float
  width        Float
  height       Float
  /// The box diagonal and box area in inches (Phase 30C, D-106); null without a calibration.
  lengthIn     Float?
  areaSqIn     Float?

  scan       Scan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  defectType DefectType? @relation(fields: [defectTypeId], references: [id])

  @@index([scanId])
  @@index([defectTypeId])
  @@map("detections")
}

// ───────────── inventory ─────────────
model InventoryItem {
  id             String            @id @default(uuid(7)) @db.Uuid
  sku            String            @unique
  name           String
  category       InventoryCategory
  unit           String // "roll", "box", "kg", "m"
  quantityOnHand Decimal           @default(0) @db.Decimal(12, 2) // changed only via movements
  reorderLevel   Decimal           @default(0) @db.Decimal(12, 2)
  /// The leather roll's supplier (Phase 29, D-102); required for LEATHER_ROLL, null otherwise.
  supplierId     String?           @db.Uuid
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  supplier  Supplier?           @relation(fields: [supplierId], references: [id])
  movements InventoryMovement[]
  /// A leather roll item's rolls, one record each (Phase 30A, D-104)
  rolls     Roll[]

  @@index([category, isActive])
  @@index([supplierId])
  @@map("inventory_items")
}

model InventoryMovement {
  id            String       @id @default(uuid(7)) @db.Uuid
  itemId        String       @db.Uuid
  type          MovementType
  quantityDelta Decimal      @db.Decimal(12, 2) // + for IN, - for OUT, either sign for ADJUST
  reason        String
  rollId        String?      @map("batchId") @db.Uuid
  /// The Update stock save this entry came from (Phase 29); null for older entries.
  updateId      String?      @db.Uuid
  createdById   String       @db.Uuid
  createdAt     DateTime     @default(now())

  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  roll      Roll?         @relation(fields: [rollId], references: [id])
  update    StockUpdate?  @relation(fields: [updateId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])

  @@index([itemId, createdAt])
  @@index([rollId])
  @@index([updateId])
  @@index([createdById])
  @@index([type, createdAt])
  @@map("inventory_movements")
}

/// One save of the Update stock sheet (Phase 29, D-102): what was added (+), used (−) or
/// corrected, per item, as ledger movements. A save on a reminder day clears the reminder.
model StockUpdate {
  id          String   @id @default(uuid(7)) @db.Uuid
  day         DateTime @db.Date // the Manila calendar date
  createdById String   @db.Uuid
  note        String?
  createdAt   DateTime @default(now())

  createdBy User                @relation(fields: [createdById], references: [id])
  movements InventoryMovement[]

  @@index([day])
  @@index([createdById])
  @@map("stock_updates")
}

/// Single row: the days the Floor Manager is reminded to update stock (Phase 29, C-32).
model InventorySettings {
  id           Int      @id @default(1)
  /// ISO weekdays, Monday (1) to Friday (5) since D-105; default Wednesday and Friday.
  reminderDays Int[]    @default([3, 5])
  updatedById  String?  @db.Uuid
  updatedAt    DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("inventory_settings")
}

// ───────────── attendance (Phase 22, D-077 to D-081) ─────────────

/// One day's attendance: a log book, never a score (D-008, D-077). A row exists only once the
/// Floor Manager saved that day; `takenBy` and `takenAt` are the last save, the audit log has all.
model AttendanceDay {
  id        String   @id @default(uuid(7)) @db.Uuid
  day       DateTime @unique @db.Date // the Manila calendar date
  takenById String   @db.Uuid
  takenAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  takenBy User             @relation("AttendanceTakenBy", fields: [takenById], references: [id])
  marks   AttendanceMark[]

  @@index([takenById])
  @@map("attendance_days")
}

/// Present or absent for one person on one day. One row per person on the roster when the day
/// was saved; re-saving the day replaces them.
model AttendanceMark {
  id              String  @id @default(uuid(7)) @db.Uuid
  attendanceDayId String  @db.Uuid
  userId          String  @db.Uuid
  present         Boolean

  attendanceDay AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Restrict)
  // The app never deletes a user (it deactivates them, D-024); only tests and demo:reset do, and
  // then the marks naming them go too, so a cleanup is never blocked by a saved day.
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([attendanceDayId, userId])
  @@index([userId])
  @@map("attendance_marks")
}

/// When each batch ends (D-083, D-097): a batch is one check-in interval of the working day. The
/// row in force on a day is the latest effectiveFrom on or before it; a change applies from the
/// next day.
model ProductionSchedule {
  id              String   @id @default(uuid(7)) @db.Uuid
  shiftStart      String // "HH:mm", Manila
  shiftEnd        String // "HH:mm", Manila
  intervalMinutes Int? // 60, 120, 180 or 240 working minutes; null = once at the end of the day
  workingDays     Int[] // ISO weekdays, 1 = Monday; 1 to 5 since D-105 (older rows may hold 6)
  effectiveFrom   DateTime @db.Date
  createdById     String?  @db.Uuid // null for the bootstrap default
  createdAt       DateTime @default(now())

  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([effectiveFrom])
  @@index([createdById])
  @@map("production_schedules")
}

/// The lunch break that pauses a batch (D-097, C-3, C-25, C-40), set by the System Admin. The same
/// on every working day; both times null = no lunch break. Applies from the next day.
model LunchBreak {
  id            String   @id @default(uuid(7)) @db.Uuid
  startTime     String? // "HH:mm", Manila
  endTime       String? // "HH:mm", Manila
  effectiveFrom DateTime @db.Date
  createdById   String?  @db.Uuid // null for the bootstrap default
  createdAt     DateTime @default(now())

  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([effectiveFrom])
  @@index([createdById])
  @@map("lunch_breaks")
}

/// Pairs per day for the whole line (D-085, D-099, C-30): one number, counted on passed pairs
/// (C-41). Never per person (D-008).
model DailyQuota {
  id             String   @id @default(uuid(7)) @db.Uuid
  pairs          Int
  suggestedPairs Int? // what the page suggested when it was set
  effectiveFrom  DateTime @db.Date
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now())

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([effectiveFrom])
  @@index([createdById])
  @@map("daily_quotas")
}

/// A finished batch (D-084, D-098): the pairs finished in it and how many of them failed
/// inspection (C-27). `slotAt` is the batch's end. One row per batch.
model ProductionCheckIn {
  id                   String    @id @default(uuid(7)) @db.Uuid
  day                  DateTime  @db.Date // the Manila calendar date
  slotAt               DateTime // the batch's end
  enteredAt            DateTime  @default(now())
  enteredById          String    @db.Uuid
  pairs                Int
  failedPairs          Int       @default(0)
  /// Shoe Constructors present when it was saved; null = attendance not taken (D-080).
  constructorsPresent  Int?
  constructorsOnRoster Int?
  notes                String?
  correctedAt          DateTime?
  correctedById        String?   @db.Uuid
  correctionReason     String?
  updatedAt            DateTime  @updatedAt

  enteredBy   User   @relation("CheckInEnteredBy", fields: [enteredById], references: [id])
  correctedBy User?  @relation("CheckInCorrectedBy", fields: [correctedById], references: [id])
  /// Rolls ticked Fully used when this batch was finished or corrected (Phase 30A)
  rollsUsed   Roll[]

  @@unique([day, slotAt])
  @@index([enteredById])
  @@index([correctedById])
  @@map("production_check_ins")
}

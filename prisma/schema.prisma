// CPoint Product Monitoring System — database schema.
// Conventions (D-018): UUIDv7 ids, snake_case tables via @@map, camelCase columns, every FK indexed,
// no hard deletes for people/production data. Only src/server/models/** may import the client.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── enums ─────────────
enum Role {
  FLOOR_MANAGER
  QUALITY_INSPECTOR
  SYSTEM_ADMIN
  SHOE_CONSTRUCTOR
}

enum Stage {
  PREPARATION
  UPPER_MAKING
  SOLEING
  FINISHING
}

enum BatchStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Verdict {
  PASS
  REWORK
  REJECT
  NEEDS_REVIEW // only as aiVerdict (unknown class key); finalVerdict is PASS/REWORK/REJECT
}

enum ScanStatus {
  PENDING_REVIEW
  DECIDED
}

/// What a found defect of a type means, whatever the model's confidence (D-053). Null on the
/// type = the confidence rule (D-011).
enum DefectAction {
  REWORK
  REJECT
}

/// How a Fixable section of a type is made usable before cutting (Phase 20, D-070). Data, set per
/// defect type in Settings.
enum DefectHandling {
  CLEAN
  CUT_AROUND
}

enum ScanSource {
  SIMULATOR
  PHONE
  WEBCAM
  DEDICATED_CAMERA
}

enum ReworkStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED // its scan's decision was overridden
}

enum SalvageStatus {
  AVAILABLE
  ASSIGNED
  DISCARDED
  CANCELLED // its scan's decision was overridden
}

enum InventoryCategory {
  LEATHER_ROLL
  NAILS
  ADHESIVE
  THREAD
  EQUIPMENT
  OTHER
}

enum MovementType {
  IN
  OUT
  ADJUST
}

/// PENDING → APPROVED → ORDERED → PARTIALLY_RECEIVED → RECEIVED, or REJECTED / CANCELLED (D-041).
enum PurchaseRequestStatus {
  PENDING
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  REJECTED
  CANCELLED
  RECEIVED
}

/// The Floor Manager's decision on one item of a request (D-039).
enum PurchaseLineDecision {
  PENDING
  APPROVED
  REJECTED
}

enum ActorType {
  USER
  DEVICE
  SYSTEM
}

// ───────────── people & access ─────────────
model User {
  id                     String    @id @default(uuid(7)) @db.Uuid
  name                   String
  email                  String    @unique // stored lower-cased
  passwordHash           String
  role                   Role
  isActive               Boolean   @default(true)
  mustChangePassword     Boolean   @default(false) // set by admin reset (Phase 6)
  /// Sessions signed in before this are ended (password reset or change, D-024).
  sessionsValidFrom      DateTime?
  failedLoginCount       Int       @default(0)
  lockedUntil            DateTime?
  lastLoginAt            DateTime?
  /// May ask for leather rolls in purchase requests. Shoe Constructors only (D-031); every
  /// constructor can request the other materials.
  canRequestLeatherRolls Boolean   @default(false)
  /// May capture at the camera (the Capture page and its Floor view). Shoe Constructors only;
  /// the QI and the Floor Manager always can (D-075).
  canCapture             Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  batchesCreated      Batch[]                 @relation("BatchCreatedBy")
  stageLogsStarted    BatchStageLog[]         @relation("StageStartedBy")
  stageLogsEnded      BatchStageLog[]         @relation("StageEndedBy")
  scanDecisions       Scan[]                  @relation("ScanDecidedBy")
  reworkCompleted     ReworkTicket[]          @relation("ReworkCompletedBy")
  salvageHandled      SalvageItem[]           @relation("SalvageHandledBy")
  movements           InventoryMovement[]
  apiTokensCreated    ApiToken[]
  cvSettingsUpdates   CvSettings[]
  auditLogs           AuditLog[]
  revokedSessions     SessionRevocation[]
  purchaseRequests    PurchaseRequest[]       @relation("PurchaseRequestedBy")
  purchaseDecisions   PurchaseRequest[]       @relation("PurchaseDecidedBy")
  purchaseLineCalls   PurchaseRequestLine[]   @relation("PurchaseLineDecidedBy")
  purchaseOrders      PurchaseRequest[]       @relation("PurchaseOrderedBy")
  purchaseEvents      PurchaseRequestEvent[]
  purchaseRemarks     PurchaseRequestRemark[]
  purchaseDeliveries  PurchaseDelivery[]
  purchaseAttachments PurchaseAttachment[]
  attendanceTaken     AttendanceDay[]         @relation("AttendanceTakenBy")
  attendanceMarks     AttendanceMark[]
  schedulesSet        ProductionSchedule[]
  quotasSet           DailyQuota[]
  checkInsEntered     ProductionCheckIn[]     @relation("CheckInEnteredBy")
  checkInsCorrected   ProductionCheckIn[]     @relation("CheckInCorrectedBy")

  @@index([role, isActive])
  @@map("users")
}

/// A signed-out session (D-025 fix): its JWT `sid` is refused even if a stale cookie comes back.
/// Rows are only needed until the token would have expired anyway; old ones are deleted on sign-out.
model SessionRevocation {
  sid       String   @id
  userId    String   @db.Uuid
  revokedAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session_revocations")
}

model ApiToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String // e.g. "Preparation phone camera"
  tokenPrefix String // first 8 chars, shown in the admin UI to identify a token
  tokenHash   String    @unique // SHA-256 of the token; the plain token is shown once
  scopes      String[] // e.g. ["scans:create"]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())

  createdBy User       @relation(fields: [createdById], references: [id])
  scans     Scan[]
  auditLogs AuditLog[]

  @@index([createdById])
  @@map("api_tokens")
}

model AuditLog {
  id           String    @id @default(uuid(7)) @db.Uuid
  actorType    ActorType
  actorUserId  String?   @db.Uuid
  actorTokenId String?   @db.Uuid
  action       String // "user.login", "batch.create", "scan.override", ...
  entity       String // "User", "Batch", "Scan", ...
  entityId     String?
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  actorUser  User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorToken ApiToken? @relation(fields: [actorTokenId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorUserId])
  @@index([actorTokenId])
  @@index([action])
  @@map("audit_logs")
}

// ───────────── reference data ─────────────
model ShoeType {
  id        String  @id @default(uuid(7)) @db.Uuid
  code      String  @unique // "SCH", "TOP"
  name      String  @unique // "School Shoe", "Topsider"
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  batches Batch[]
  quotas  DailyQuota[]
  counts  ProductionCount[]

  @@map("shoe_types")
}

model Supplier {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String   @unique
  contactPerson String?
  phone         String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  batches          Batch[]
  purchaseRequests PurchaseRequest[]

  @@map("suppliers")
}

model DefectType {
  id          String         @id @default(uuid(7)) @db.Uuid
  key         String         @unique // YOLO class key: "cut", "hole", "abrasion", "dirt"
  label       String
  description String?
  isActive    Boolean        @default(true) // inactive types are ignored by the decision engine
  /// Rework or Reject once found (confidence ≥ CvSettings.foundAtOrAbove); null = by confidence (D-053)
  action      DefectAction?
  /// Clean the section, or cut around the defect, when it's Fixable (D-070)
  handling    DefectHandling @default(CUT_AROUND)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  detections Detection[]

  @@map("defect_types")
}

model CvSettings {
  id               Int      @id @default(1)
  rejectAtOrAbove  Float    @default(0.9)
  reworkAtOrAbove  Float    @default(0.6)
  /// A detection of a type with an action counts as found from this confidence (D-053).
  foundAtOrAbove   Float    @default(0.5)
  /// Show the early-model notice on the Camera page (D-055).
  earlyModelNotice Boolean  @default(true)
  /// The batch the single Preparation camera feeds (D-020). Null = oldest batch at Preparation.
  activeBatchId    String?  @db.Uuid
  updatedById      String?  @db.Uuid
  updatedAt        DateTime @updatedAt

  activeBatch Batch? @relation("CameraActiveBatch", fields: [activeBatchId], references: [id], onDelete: SetNull)
  updatedBy   User?  @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([activeBatchId])
  @@index([updatedById])
  @@map("cv_settings")
}

// ───────────── production ─────────────
model BatchSequence {
  year      Int @id
  lastValue Int @default(0)

  @@map("batch_sequences")
}

model Batch {
  id               String      @id @default(uuid(7)) @db.Uuid
  code             String      @unique
  rollCode         String
  supplierId       String?     @db.Uuid
  shoeTypeId       String      @db.Uuid
  receivedAt       DateTime    @db.Date
  targetQuotaPairs Int?
  status           BatchStatus @default(PLANNED)
  currentStage     Stage       @default(PREPARATION)
  notes            String?
  cancelledReason  String?
  createdById      String      @db.Uuid
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  supplier        Supplier?           @relation(fields: [supplierId], references: [id])
  shoeType        ShoeType            @relation(fields: [shoeTypeId], references: [id])
  createdBy       User                @relation("BatchCreatedBy", fields: [createdById], references: [id])
  stageLogs       BatchStageLog[]
  scans           Scan[]
  salvageOrigin   SalvageItem[]       @relation("SalvageOrigin")
  salvageAssigned SalvageItem[]       @relation("SalvageAssigned")
  cameraSettings  CvSettings[]        @relation("CameraActiveBatch")
  movements       InventoryMovement[]

  @@index([status, currentStage])
  @@index([supplierId])
  @@index([shoeTypeId])
  @@index([createdById])
  @@index([createdAt])
  @@map("batches")
}

model BatchStageLog {
  id          String    @id @default(uuid(7)) @db.Uuid
  batchId     String    @db.Uuid
  stage       Stage
  startedAt   DateTime  @default(now())
  endedAt     DateTime? // null = stage in progress (one open log per batch, enforced in service)
  startedById String    @db.Uuid
  endedById   String?   @db.Uuid
  isRollback  Boolean   @default(false)
  reason      String? // required when isRollback
  notes       String?

  batch     Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  startedBy User  @relation("StageStartedBy", fields: [startedById], references: [id])
  endedBy   User? @relation("StageEndedBy", fields: [endedById], references: [id])

  @@index([batchId, startedAt])
  @@index([stage, startedAt])
  @@index([startedById])
  @@index([endedById])
  @@map("batch_stage_logs")
}

// ───────────── computer vision ─────────────
model Scan {
  id                 String     @id @default(uuid(7)) @db.Uuid
  batchId            String     @db.Uuid
  sequence           Int // 1..n within the batch
  imagePath          String?
  imageMime          String?
  source             ScanSource
  modelVersion       String?
  deviceTokenId      String?    @db.Uuid
  captureId          String?    @unique @db.Uuid // set by the camera; a retry returns the first scan (D-051)
  aiVerdict          Verdict
  maxConfidence      Float?
  thresholdsSnapshot Json // { rejectAtOrAbove, reworkAtOrAbove } used for this decision
  finalVerdict       Verdict? // null while PENDING_REVIEW
  status             ScanStatus
  isOverride         Boolean    @default(false)
  overrideReason     String?
  decidedById        String?    @db.Uuid // null = decided automatically
  decidedAt          DateTime?
  capturedAt         DateTime   @default(now())
  createdAt          DateTime   @default(now())

  batch         Batch          @relation(fields: [batchId], references: [id], onDelete: Restrict)
  deviceToken   ApiToken?      @relation(fields: [deviceTokenId], references: [id], onDelete: SetNull)
  decidedBy     User?          @relation("ScanDecidedBy", fields: [decidedById], references: [id])
  detections    Detection[]
  reworkTickets ReworkTicket[]
  salvageItems  SalvageItem[]

  @@unique([batchId, sequence])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([finalVerdict])
  @@index([deviceTokenId])
  @@index([decidedById])
  @@map("scans")
}

model Detection {
  id             String  @id @default(uuid(7)) @db.Uuid
  scanId         String  @db.Uuid
  defectTypeId   String? @db.Uuid // null when the class key is unknown
  rawClassKey    String // exactly what the model sent
  isUnknownClass Boolean @default(false)
  confidence     Float
  x              Float // bounding box, fractions 0–1 of the image
  y              Float
  width          Float
  height         Float

  scan       Scan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  defectType DefectType? @relation(fields: [defectTypeId], references: [id])

  @@index([scanId])
  @@index([defectTypeId])
  @@map("detections")
}

model ReworkTicket {
  id            String       @id @default(uuid(7)) @db.Uuid
  scanId        String       @db.Uuid // one non-cancelled ticket per scan (service-enforced)
  status        ReworkStatus @default(OPEN)
  notes         String?
  openedAt      DateTime     @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  completedById String?      @db.Uuid
  cancelledAt   DateTime?

  scan        Scan  @relation(fields: [scanId], references: [id], onDelete: Cascade)
  completedBy User? @relation("ReworkCompletedBy", fields: [completedById], references: [id])

  @@index([scanId])
  @@index([status, openedAt])
  @@index([completedById])
  @@map("rework_tickets")
}

model SalvageItem {
  id              String        @id @default(uuid(7)) @db.Uuid
  scanId          String        @db.Uuid
  originBatchId   String        @db.Uuid
  status          SalvageStatus @default(AVAILABLE)
  assignedBatchId String?       @db.Uuid
  assignedAt      DateTime?
  discardedAt     DateTime?
  handledById     String?       @db.Uuid
  notes           String?
  createdAt       DateTime      @default(now())

  scan          Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  originBatch   Batch  @relation("SalvageOrigin", fields: [originBatchId], references: [id])
  assignedBatch Batch? @relation("SalvageAssigned", fields: [assignedBatchId], references: [id])
  handledBy     User?  @relation("SalvageHandledBy", fields: [handledById], references: [id])

  @@index([scanId])
  @@index([originBatchId])
  @@index([assignedBatchId])
  @@index([status])
  @@index([handledById])
  @@map("salvage_items")
}

// ───────────── inventory ─────────────
model InventoryItem {
  id             String            @id @default(uuid(7)) @db.Uuid
  sku            String            @unique
  name           String
  category       InventoryCategory
  unit           String // "roll", "box", "kg", "m"
  quantityOnHand Decimal           @default(0) @db.Decimal(12, 2) // changed only via movements
  reorderLevel   Decimal           @default(0) @db.Decimal(12, 2)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  movements    InventoryMovement[]
  requestLines PurchaseRequestLine[]

  @@index([category, isActive])
  @@map("inventory_items")
}

model InventoryMovement {
  id            String       @id @default(uuid(7)) @db.Uuid
  itemId        String       @db.Uuid
  type          MovementType
  quantityDelta Decimal      @db.Decimal(12, 2) // + for IN, - for OUT, either sign for ADJUST
  reason        String
  batchId       String?      @db.Uuid
  createdById   String       @db.Uuid
  createdAt     DateTime     @default(now())

  item          InventoryItem          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batch         Batch?                 @relation(fields: [batchId], references: [id])
  createdBy     User                   @relation(fields: [createdById], references: [id])
  deliveryLines PurchaseDeliveryLine[]

  @@index([itemId, createdAt])
  @@index([batchId])
  @@index([createdById])
  @@map("inventory_movements")
}

// ───────────── procurement (D-029) ─────────────
model PurchaseRequestSequence {
  year      Int @id
  lastValue Int @default(0)

  @@map("purchase_request_sequences")
}

/// A Shoe Constructor (or the Floor Manager, D-045) asks for materials; the Floor Manager decides
/// each item (D-039), orders the approved ones from one supplier (D-041) and records each delivery
/// with its proof (D-042). Never edited after it's submitted: cancel it, or copy it to a new one
/// (D-044). Why it's needed goes in the first remark (D-036).
model PurchaseRequest {
  id                 String                @id @default(uuid(7)) @db.Uuid
  code               String                @unique // MR-2026-0001
  requestedById      String                @db.Uuid
  status             PurchaseRequestStatus @default(PENDING)
  /// Required. Urgency is worked out from it at read time and never stored (D-037).
  neededBy           DateTime              @db.Date
  decidedById        String?               @db.Uuid
  decidedAt          DateTime?
  rejectionReason    String?
  approvalNote       String?
  /// The order: one supplier and one expected date for the whole request (D-041).
  supplierId         String?               @db.Uuid
  orderReference     String?
  expectedDeliveryOn DateTime?             @db.Date
  orderNote          String?
  orderedById        String?               @db.Uuid
  orderedAt          DateTime?
  /// Why it was cancelled. Required when the Floor Manager cancels after approval (D-043).
  cancelReason       String?
  /// Set when a partly received request is closed because the rest won't come (D-042).
  closedShortAt      DateTime?
  closedShortReason  String?
  /// The rejected or cancelled request this one was copied from (D-044).
  copiedFromId       String?               @db.Uuid
  receivedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  requestedBy User                    @relation("PurchaseRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?                   @relation("PurchaseDecidedBy", fields: [decidedById], references: [id])
  orderedBy   User?                   @relation("PurchaseOrderedBy", fields: [orderedById], references: [id])
  supplier    Supplier?               @relation(fields: [supplierId], references: [id])
  copiedFrom  PurchaseRequest?        @relation("PurchaseRequestCopies", fields: [copiedFromId], references: [id])
  copies      PurchaseRequest[]       @relation("PurchaseRequestCopies")
  lines       PurchaseRequestLine[]
  events      PurchaseRequestEvent[]
  remarks     PurchaseRequestRemark[]
  deliveries  PurchaseDelivery[]

  @@index([status, createdAt])
  @@index([requestedById])
  @@index([decidedById])
  @@index([orderedById])
  @@index([supplierId])
  @@index([copiedFromId])
  @@map("purchase_requests")
}

model PurchaseRequestLine {
  id                    String               @id @default(uuid(7)) @db.Uuid
  requestId             String               @db.Uuid
  inventoryItemId       String?              @db.Uuid // null: an item not in inventory yet
  itemName              String // copied from the item, or typed
  /// Copied from the item, or chosen for a typed one, so leather rolls are always recognised (D-031).
  category              InventoryCategory
  unit                  String
  quantity              Decimal              @db.Decimal(12, 2)
  note                  String?
  /// Stock when the request was made, so the Floor Manager sees why it was asked for.
  onHandAtRequest       Decimal?             @db.Decimal(12, 2)
  reorderLevelAtRequest Decimal?             @db.Decimal(12, 2)
  /// Adds up over deliveries; never more than the quantity (D-042).
  receivedQuantity      Decimal              @default(0) @db.Decimal(12, 2)
  position              Int
  /// Each item is approved or rejected on its own; the request's status follows from them (D-039).
  decision              PurchaseLineDecision @default(PENDING)
  rejectionReason       String? // required when decision is REJECTED
  decidedById           String?              @db.Uuid
  decidedAt             DateTime?

  request       PurchaseRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item          InventoryItem?         @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  decidedBy     User?                  @relation("PurchaseLineDecidedBy", fields: [decidedById], references: [id])
  deliveryLines PurchaseDeliveryLine[]

  @@index([requestId])
  @@index([inventoryItemId])
  @@index([decidedById])
  @@map("purchase_request_lines")
}

/// The request's timeline, shown to everyone who can see the request (the audit log is admin-only).
model PurchaseRequestEvent {
  id         String                 @id @default(uuid(7)) @db.Uuid
  requestId  String                 @db.Uuid
  fromStatus PurchaseRequestStatus? // null when submitted
  toStatus   PurchaseRequestStatus
  actorId    String                 @db.Uuid
  note       String?
  /// The delivery this event recorded, so the timeline can show its proof files.
  deliveryId String?                @db.Uuid
  createdAt  DateTime               @default(now())

  request  PurchaseRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor    User              @relation(fields: [actorId], references: [id])
  delivery PurchaseDelivery? @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([actorId])
  @@index([deliveryId])
  @@map("purchase_request_events")
}

/// One delivery against an ordered request (D-042). A request can have several: what arrives short
/// stays outstanding until the next one, or until the request is closed short.
model PurchaseDelivery {
  id           String   @id @default(uuid(7)) @db.Uuid
  requestId    String   @db.Uuid
  deliveredOn  DateTime @db.Date
  note         String?
  recordedById String   @db.Uuid
  createdAt    DateTime @default(now())

  request     PurchaseRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  recordedBy  User                   @relation(fields: [recordedById], references: [id])
  lines       PurchaseDeliveryLine[]
  attachments PurchaseAttachment[]
  events      PurchaseRequestEvent[]

  @@index([requestId, createdAt])
  @@index([recordedById])
  @@map("purchase_deliveries")
}

/// How much of one request item arrived in one delivery, and the stock IN it posted (D-023).
model PurchaseDeliveryLine {
  id         String  @id @default(uuid(7)) @db.Uuid
  deliveryId String  @db.Uuid
  lineId     String  @db.Uuid
  quantity   Decimal @db.Decimal(12, 2)
  movementId String? @db.Uuid // null for an item that isn't in inventory

  delivery PurchaseDelivery    @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  line     PurchaseRequestLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  movement InventoryMovement?  @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@unique([deliveryId, lineId])
  @@index([lineId])
  @@index([movementId])
  @@map("purchase_delivery_lines")
}

/// A proof-of-delivery file: a photo or PDF of the supplier's receipt (D-042). Never deleted; a
/// wrong file is corrected by adding the right one. The key is generated by the server (D-020).
model PurchaseAttachment {
  id           String   @id @default(uuid(7)) @db.Uuid
  deliveryId   String   @db.Uuid
  storageKey   String   @unique
  mime         String
  size         Int
  originalName String
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())

  delivery   PurchaseDelivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  uploadedBy User             @relation(fields: [uploadedById], references: [id])

  @@index([deliveryId, createdAt])
  @@index([uploadedById])
  @@map("purchase_attachments")
}

/// Remarks are only ever added, never edited or deleted.
model PurchaseRequestRemark {
  id        String   @id @default(uuid(7)) @db.Uuid
  requestId String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  request PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User            @relation(fields: [authorId], references: [id])

  @@index([requestId, createdAt])
  @@index([authorId])
  @@map("purchase_request_remarks")
}

// ───────────── attendance (Phase 22, D-077 to D-081) ─────────────

/// One day's attendance: a log book, never a score (D-008, D-077). A row exists only once the
/// Floor Manager saved that day; `takenBy` and `takenAt` are the last save, the audit log has all.
model AttendanceDay {
  id        String   @id @default(uuid(7)) @db.Uuid
  day       DateTime @unique @db.Date // the Manila calendar date
  takenById String   @db.Uuid
  takenAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  takenBy User             @relation("AttendanceTakenBy", fields: [takenById], references: [id])
  marks   AttendanceMark[]

  @@index([takenById])
  @@map("attendance_days")
}

/// Present or absent for one person on one day. One row per person on the roster when the day
/// was saved; re-saving the day replaces them.
model AttendanceMark {
  id              String  @id @default(uuid(7)) @db.Uuid
  attendanceDayId String  @db.Uuid
  userId          String  @db.Uuid
  present         Boolean

  attendanceDay AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Restrict)
  // The app never deletes a user (it deactivates them, D-024); only tests and demo:reset do, and
  // then the marks naming them go too, so a cleanup is never blocked by a saved day.
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([attendanceDayId, userId])
  @@index([userId])
  @@map("attendance_marks")
}

/// When the Quality Inspector counts finished pairs (D-083). The row in force on a day is the
/// latest effectiveFrom on or before it; a change applies from the next day.
model ProductionSchedule {
  id              String   @id @default(uuid(7)) @db.Uuid
  shiftStart      String // "HH:mm", Manila
  shiftEnd        String // "HH:mm", Manila
  intervalMinutes Int // 60, 120, 180 or 240
  workingDays     Int[] // ISO weekdays, 1 = Monday
  effectiveFrom   DateTime @db.Date
  createdById     String?  @db.Uuid // null for the bootstrap default
  createdAt       DateTime @default(now())

  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([effectiveFrom])
  @@index([createdById])
  @@map("production_schedules")
}

/// Pairs per shoe type per day for the whole line (D-085). Never per person (D-008).
model DailyQuota {
  id             String   @id @default(uuid(7)) @db.Uuid
  shoeTypeId     String   @db.Uuid
  pairs          Int
  suggestedPairs Int? // what the page suggested when it was set
  effectiveFrom  DateTime @db.Date
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now())

  shoeType  ShoeType @relation(fields: [shoeTypeId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([shoeTypeId, effectiveFrom])
  @@index([createdById])
  @@map("daily_quotas")
}

/// One scheduled count of the pairs finished since the previous check-in (D-084).
model ProductionCheckIn {
  id                   String    @id @default(uuid(7)) @db.Uuid
  day                  DateTime  @db.Date // the Manila calendar date
  slotAt               DateTime // the scheduled time
  enteredAt            DateTime  @default(now())
  enteredById          String    @db.Uuid
  /// Shoe Constructors present when it was saved; null = attendance not taken (D-080).
  constructorsPresent  Int?
  constructorsOnRoster Int?
  notes                String?
  correctedAt          DateTime?
  correctedById        String?   @db.Uuid
  correctionReason     String?
  updatedAt            DateTime  @updatedAt

  enteredBy   User              @relation("CheckInEnteredBy", fields: [enteredById], references: [id])
  correctedBy User?             @relation("CheckInCorrectedBy", fields: [correctedById], references: [id])
  counts      ProductionCount[]

  @@unique([day, slotAt])
  @@index([enteredById])
  @@index([correctedById])
  @@map("production_check_ins")
}

model ProductionCount {
  id         String @id @default(uuid(7)) @db.Uuid
  checkInId  String @db.Uuid
  shoeTypeId String @db.Uuid
  pairs      Int

  checkIn  ProductionCheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  shoeType ShoeType          @relation(fields: [shoeTypeId], references: [id])

  @@unique([checkInId, shoeTypeId])
  @@index([shoeTypeId])
  @@map("production_counts")
}

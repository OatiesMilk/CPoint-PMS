// CPoint Product Monitoring System — database schema.
// Conventions (D-018): UUIDv7 ids, snake_case tables via @@map, camelCase columns, every FK indexed,
// no hard deletes for people/production data. Only src/server/models/** may import the client.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── enums ─────────────
enum Role {
  FLOOR_MANAGER
  QUALITY_INSPECTOR
  SYSTEM_ADMIN
  SHOE_CONSTRUCTOR
}

/// A roll is captured shot by shot at Capture until all of it is in (Phase 26, D-095).
/// A roll's life since Phase 30E (D-112, D-113): added to its leather item by the Floor Manager with
/// its area (IN_STOCK), picked at Capture (OPEN), finished there and taken off stock (FINISHED), or
/// removed with a reason (CANCELLED). USED (Fully used at Finish batch) and RETURNED (Phase 30C)
/// remain for old rows only.
enum RollStatus {
  IN_STOCK
  OPEN
  FINISHED
  USED
  /// Sent back to the supplier on the Floor Manager's decision (Phase 30C, D-110, C-36).
  RETURNED
  CANCELLED
}

/// The Floor Manager's decision on a finished roll (Phase 30C, D-110, C-36).
enum ReturnDecision {
  RETURNED
  KEPT
}

/// A section is Pass or Reject, and the camera's verdict is final (Phase 25, D-093).
enum Verdict {
  PASS
  REJECT
}

/// What a found defect of a type means for the section (D-093): Usable leaves it Pass, Not
/// accepted rejects it. Data, set per defect type in Settings.
enum DefectOutcome {
  USABLE
  NOT_ACCEPTED
}

enum ScanSource {
  SIMULATOR
  PHONE
  WEBCAM
  DEDICATED_CAMERA
}

enum InventoryCategory {
  LEATHER_ROLL
  NAILS
  ADHESIVE
  THREAD
  EQUIPMENT
  OTHER
}

enum MovementType {
  IN
  OUT
  ADJUST
}

/// A day on the planning calendar (D-114).
enum DayKind {
  PLANNED
  NON_WORKING
}

/// A batch's life in the Inspection queue (Phase 33, D-129). Upcoming, In progress, Waiting and Late
/// are worked out from the clock (the demo clock moves it), never stored.
enum BatchStatus {
  OPEN
  INSPECTING
  INSPECTED
  VOID
}

enum BatchPriority {
  NORMAL
  URGENT
}

/// The four stages of the line (Phase 34, D-130). Construction was "Upper making".
enum ProductionStage {
  PREPARATION
  CONSTRUCTION
  SOLE_ING
  FINISHING
}

/// What the QI decides for a failed pair (Phase 34, D-130).
enum Remedy {
  FIXABLE
  NOT_FIXABLE
}

/// A repair job's life (Phase 34, D-130): at its stage, back for inspection, done; or cancelled
/// (the Floor Manager marked it Not fixable, or a correction remade it).
enum RepairStatus {
  AT_STAGE
  BACK_FOR_INSPECTION
  DONE
  CANCELLED
}

enum ActorType {
  USER
  DEVICE
  SYSTEM
}

// ───────────── people & access ─────────────
model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  name               String
  email              String    @unique // stored lower-cased
  passwordHash       String
  role               Role
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false) // set by admin reset (Phase 6)
  /// Sessions signed in before this are ended (password reset or change, D-024).
  sessionsValidFrom  DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  /// Has camera access: may start, capture and finish rolls at Capture on their phone. Shoe
  /// Constructors only, granted by the System Admin (D-075, Phase 26).
  canCapture         Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  rollsCreated       Roll[]              @relation("RollCreatedBy")
  rollsFinished      Roll[]              @relation("RollFinishedBy")
  rollsCancelled     Roll[]              @relation("RollCancelledBy")
  rollsStarted       Roll[]              @relation("RollStartedBy")
  rollsUsed          Roll[]              @relation("RollUsedBy")
  rollsDecided       Roll[]              @relation("RollReturnDecidedBy")
  movements          InventoryMovement[]
  apiTokensCreated   ApiToken[]
  cvSettingsUpdates  CvSettings[]
  auditLogs          AuditLog[]
  revokedSessions    SessionRevocation[]
  attendanceTaken    AttendanceDay[]     @relation("AttendanceTakenBy")
  attendanceMarks    AttendanceMark[]
  lunchBreaksSet     LunchBreak[]
  dayPlansCreated    DayPlan[]           @relation("DayPlanCreatedBy")
  dayPlansUpdated    DayPlan[]           @relation("DayPlanUpdatedBy")
  checkInsEntered    ProductionCheckIn[] @relation("CheckInEnteredBy")
  checkInsCorrected  ProductionCheckIn[] @relation("CheckInCorrectedBy")
  batchesStarted     ProductionBatch[]   @relation("BatchInspectionStartedBy")
  batchesPrioritised ProductionBatch[]   @relation("BatchPrioritySetBy")
  batchesVoided      ProductionBatch[]   @relation("BatchVoidedBy")
  stockUpdates       StockUpdate[]
  inventorySettings  InventorySettings[]
  locationsCreated   StorageLocation[]   @relation("LocationCreatedBy")
  rollMoves          RollMove[]          @relation("RollMoveBy")
  repairsBack        RepairJob[]         @relation("RepairBackBy")
  repairsInspected   RepairJob[]         @relation("RepairInspectedBy")
  stageAssignments   StageAssignment[]   @relation("StageAssignee")
  stageAssigned      StageAssignment[]   @relation("StageAssignedBy")
  stageCounts        StageCount[]        @relation("StageCountBy")

  @@index([role, isActive])
  @@map("users")
}

/// A signed-out session (D-025 fix): its JWT `sid` is refused even if a stale cookie comes back.
/// Rows are only needed until the token would have expired anyway; old ones are deleted on sign-out.
model SessionRevocation {
  sid       String   @id
  userId    String   @db.Uuid
  revokedAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session_revocations")
}

model ApiToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String // e.g. "Preparation phone camera"
  tokenPrefix String // first 8 chars, shown in the admin UI to identify a token
  tokenHash   String    @unique // SHA-256 of the token; the plain token is shown once
  scopes      String[] // e.g. ["scans:create"]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())

  createdBy User       @relation(fields: [createdById], references: [id])
  scans     Scan[]
  auditLogs AuditLog[]

  @@index([createdById])
  @@map("api_tokens")
}

model AuditLog {
  id           String    @id @default(uuid(7)) @db.Uuid
  actorType    ActorType
  actorUserId  String?   @db.Uuid
  actorTokenId String?   @db.Uuid
  action       String // "user.login", "roll.create", "scan.override", ...
  entity       String // "User", "Roll", "Scan", ...
  entityId     String?
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  actorUser  User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorToken ApiToken? @relation(fields: [actorTokenId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorUserId])
  @@index([actorTokenId])
  @@index([action])
  @@map("audit_logs")
}

// ───────────── reference data ─────────────
model Supplier {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String   @unique
  contactPerson String?
  phone         String?
  notes         String?
  /// Short code, 2 to 6 capital letters or digits. Since Phase 42 (D-139) it only seeds the supplier's
  /// first roll tag; roll codes come from the roll tags (LR-<tag>-001).
  code          String   @unique
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  rolls          Roll[]
  inventoryItems InventoryItem[]
  rollTags       RollTag[]

  @@map("suppliers")
}

model DefectType {
  id                String        @id @default(uuid(7)) @db.Uuid
  key               String        @unique // YOLO class key: "cut", "hole", "abrasion", "dirt"
  label             String
  description       String?
  isActive          Boolean       @default(true) // inactive types are ignored by the decision engine
  /// Usable or Not accepted once found (confidence ≥ CvSettings.foundAtOrAbove, D-093)
  outcome           DefectOutcome
  /// Not accepted from this length in inches (the box diagonal, D-106) and Usable below it
  /// (Phase 30C, C-37: cut 3). Null: no length limit, `outcome` applies.
  notAcceptedFromIn Float?
  /// Counts as this flat share of the roll instead of its box area (D-110: a cut from its length
  /// limit counts 1%). Null: counted by its box area.
  flatSharePct      Float?
  sortOrder         Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  detections Detection[]

  @@map("defect_types")
}

model CvSettings {
  id               Int      @id @default(1)
  /// A detection counts as found from this confidence (D-053); below it, it counts for nothing.
  foundAtOrAbove   Float    @default(0.5)
  /// Show the early-model notice on the Camera page (D-055).
  earlyModelNotice Boolean  @default(true)
  /// A finished roll is marked Return to supplier when its defect share is more than this (C-9).
  returnSharePct   Float    @default(10)
  updatedById      String?  @db.Uuid
  updatedAt        DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("cv_settings")
}

/// The demo clock (D-125): while the demo tools are on, the app's "now" is the real time plus
/// this offset, so a demo can be shown at any day and hour. One row; 0 is real time. Ignored when
/// DEMO_LOGIN_TOOLS is off.
model DemoClock {
  id        Int      @id @default(1)
  offsetMs  BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@map("demo_clock")
}

// ───────────── production ─────────────
/// The yearly R-YYYY-NNNN numbers of Phases 26 to 29 (history; no new codes since Phase 30A).
model RollSequence {
  year      Int @id
  lastValue Int @default(0)

  @@map("batch_sequences")
}

/// The next number per roll-code prefix, e.g. "LR-MLT" (Phase 30A, D-104). Unused since Phase 42
/// (the next free number is read from the rolls); dropped in a later clean-up.
model RollCodeSequence {
  prefix    String @id
  lastValue Int    @default(0)

  @@map("roll_code_sequences")
}

/// A roll tag (Phase 42, D-139): the middle of a roll code, LR-<code>-001. The Floor Manager keeps the
/// list under Inventory → Roll tags; Add rolls picks one per roll. CPoint hasn't confirmed its real
/// tag codes (A-119).
model RollTag {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// 2 to 6 capital letters or digits, starting with a letter (like a supplier's short code).
  code       String   @unique
  /// The supplier this tag belongs to; null = a tag for any supplier.
  supplierId String?  @db.Uuid
  /// The supplier's default in the Add rolls dropdown; at most one per supplier (kept by the service).
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier Supplier? @relation(fields: [supplierId], references: [id])
  /// The rolls whose code was made from it (rolls from before Phase 42 have none).
  rolls    Roll[]

  @@index([supplierId])
  @@map("roll_tags")
}

/// One leather roll from a supplier (the table keeps its old name, D-095). Since Phase 30A
/// (D-104) the Floor Manager adds it to Inventory with its area; a Shoe Constructor picks it at
/// Capture, captures it shot by shot and finishes it; the QI ticks it Fully used at Finish batch.
model Roll {
  id                String          @id @default(uuid(7)) @db.Uuid
  /// LR-BLC-001: LR-, the roll tag's code, the digits (Phase 42, D-139). Older R-YYYY-NNNN and B-YYYY-NNNN rolls were renamed to LR-… in Phase 33 (D-129),
  /// so B- means a batch only.
  code              String          @unique
  /// The roll's code before Phase 33's rename (an old label or claim sheet); still found by Find roll.
  formerCode        String?         @unique
  /// The number on the supplier's own paper tag, optional (typed in Add rolls until Phase 42; now only
  /// corrected in Edit roll details).
  tagCode           String?         @map("rollCode")
  /// The roll tag its code was made from (Phase 42); null for rolls from before.
  tagId             String?         @db.Uuid
  supplierId        String?         @db.Uuid // the leather item's supplier; older rolls may have none
  /// The leather item it belongs to (Phase 30A); null for rolls from before.
  itemId            String?         @db.Uuid
  /// Its area in square feet, from the stamp or the receipt (D-103); null for rolls from before.
  areaSqFt          Decimal?        @db.Decimal(8, 2)
  receivedAt        DateTime?       @db.Date
  status            RollStatus // always set by the service; no default (the enum value is new)
  /// Who added the record (the Floor Manager; before Phase 30A, who started it). Kept for the
  /// audit only, never shown or totalled per person (D-008).
  createdById       String          @db.Uuid
  /// Picked at Capture: when, and by whom (only to start the Roll dropdown on their roll, D-008).
  startedAt         DateTime?
  startedById       String?         @db.Uuid
  finishedAt        DateTime?
  finishedById      String?         @db.Uuid
  cancelledAt       DateTime?
  cancelledById     String?         @db.Uuid
  cancelledReason   String?
  /// Ticked Fully used at Finish batch (Phase 30A): when, by whom (audit only) and in which batch.
  usedAt            DateTime?
  usedById          String?         @db.Uuid
  usedCheckInId     String?         @db.Uuid
  /// Worked out at Finish roll (Phase 30C, D-110): the defect area, the share of the entered area
  /// (flat shares included) and the limit then. Null when the roll couldn't be measured.
  defectAreaSqIn    Float?
  defectSharePct    Float?
  returnLimitPct    Float?
  /// Over the limit at Finish roll: Return to supplier, for the Floor Manager to decide.
  markedForReturn   Boolean         @default(false)
  /// The Floor Manager's decision (C-36): returned on a date, or kept with a reason. Who decided
  /// is kept for the audit only (D-008).
  returnDecision    ReturnDecision?
  returnedOn        DateTime?       @db.Date
  returnNote        String?
  returnDecidedAt   DateTime?
  returnDecidedById String?         @db.Uuid
  /// Where it is kept now (Phase 32, D-128): only a roll in stock, or one Returned to supplier
  /// that is set aside until the supplier picks it up. Null = not placed / left storage.
  locationId        String?         @db.Uuid
  locatedAt         DateTime?
  /// Returned to supplier and taken by the supplier (Phase 32, A-77); null until then.
  pickedUpAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  supplier        Supplier?           @relation(fields: [supplierId], references: [id])
  tag             RollTag?            @relation(fields: [tagId], references: [id])
  item            InventoryItem?      @relation(fields: [itemId], references: [id])
  createdBy       User                @relation("RollCreatedBy", fields: [createdById], references: [id])
  startedBy       User?               @relation("RollStartedBy", fields: [startedById], references: [id])
  finishedBy      User?               @relation("RollFinishedBy", fields: [finishedById], references: [id])
  cancelledBy     User?               @relation("RollCancelledBy", fields: [cancelledById], references: [id])
  usedBy          User?               @relation("RollUsedBy", fields: [usedById], references: [id])
  returnDecidedBy User?               @relation("RollReturnDecidedBy", fields: [returnDecidedById], references: [id])
  usedCheckIn     ProductionCheckIn?  @relation(fields: [usedCheckInId], references: [id])
  location        StorageLocation?    @relation(fields: [locationId], references: [id])
  /// Its location history, one row per change (Phase 32)
  moves           RollMove[]
  scans           Scan[]
  /// Its stock entries: added (+1), and fully used or removed (−1) since Phase 30A
  movements       InventoryMovement[]

  @@index([status, startedAt])
  @@index([status, startedById])
  @@index([itemId, status])
  @@index([supplierId])
  @@index([tagId])
  @@index([createdById])
  @@index([startedById])
  @@index([usedById])
  @@index([returnDecidedById])
  @@index([markedForReturn, returnDecision])
  @@index([usedCheckInId])
  @@index([finishedById])
  @@index([cancelledById])
  @@index([createdAt])
  @@index([locationId])
  @@map("batches")
}

/// Where a roll can be kept (Phase 32, D-128): a rack, a bin or a floor area. CPoint hasn't
/// confirmed its rack layout (A-53), so the codes are theirs to choose; R1-B3 is a placeholder.
enum LocationKind {
  RACK
  BIN
  AREA
}

model StorageLocation {
  id          String       @id @default(uuid(7)) @db.Uuid
  /// Printed on its label and inside its QR as LOC:<code> ("R1-B3"); upper case, unique.
  code        String       @unique
  /// What people call it ("Rack 1, bin 3"); optional.
  name        String?
  kind        LocationKind
  notes       String?
  /// Only an empty location can be deactivated; inactive ones are left out of every picker.
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  /// Who added it: kept for the audit only (D-008).
  createdById String       @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdBy User       @relation("LocationCreatedBy", fields: [createdById], references: [id])
  rolls     Roll[]
  movesFrom RollMove[] @relation("MoveFrom")
  movesTo   RollMove[] @relation("MoveTo")

  @@index([isActive, sortOrder])
  @@index([createdById])
  @@map("storage_locations")
}

/// Why a roll's location changed (Phase 32, D-128).
enum RollMoveReason {
  /// First placed: at Add rolls, or later on a roll with no location
  PLACED
  /// Moved by the Floor Manager
  MOVED
  /// Picked at Capture; the roll leaves its location
  TAKEN_FOR_USE
  /// Put back at Capture
  PUT_BACK
  /// Removed with a reason; the roll leaves its location
  REMOVED
  /// Finished as Returned to supplier and set aside for the supplier
  SET_ASIDE_FOR_RETURN
  /// Taken by the supplier; the roll leaves its location
  PICKED_UP_BY_SUPPLIER
}

/// One change of a roll's location: the roll's location history (Phase 32, D-128).
model RollMove {
  id             String         @id @default(uuid(7)) @db.Uuid
  rollId         String         @db.Uuid
  fromLocationId String?        @db.Uuid
  toLocationId   String?        @db.Uuid
  reason         RollMoveReason
  note           String?
  /// Who did it: kept for the audit only, never shown or totalled per person (D-008, A-78).
  byId           String         @db.Uuid
  at             DateTime       @default(now())

  roll         Roll             @relation(fields: [rollId], references: [id])
  fromLocation StorageLocation? @relation("MoveFrom", fields: [fromLocationId], references: [id])
  toLocation   StorageLocation? @relation("MoveTo", fields: [toLocationId], references: [id])
  by           User             @relation("RollMoveBy", fields: [byId], references: [id])

  @@index([rollId, at])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([byId])
  @@map("roll_moves")
}

// ───────────── computer vision ─────────────
model Scan {
  id                 String     @id @default(uuid(7)) @db.Uuid
  rollId             String     @map("batchId") @db.Uuid
  sequence           Int // 1..n within the roll
  imagePath          String?
  imageMime          String?
  source             ScanSource
  modelVersion       String?
  deviceTokenId      String?    @db.Uuid
  captureId          String?    @unique @db.Uuid // set by the camera; a retry returns the first scan (D-051)
  aiVerdict          Verdict
  maxConfidence      Float?
  thresholdsSnapshot Json // the rule in force: { foundAtOrAbove, outcomes } (older scans: thresholds, actions)
  finalVerdict       Verdict // always equal to aiVerdict since Phase 25: nobody changes it (D-093)
  /// The photo's size in pixels (EXIF turns applied) and the inches across its width from the
  /// phone's calibration (Phase 30C, A-18); widthIn is null when the phone wasn't calibrated.
  imageWidth         Int?
  imageHeight        Int?
  widthIn            Float?
  /// The union of the found defects counted by box area, in square inches (C-35, D-106).
  defectAreaSqIn     Float?
  /// The flat shares of the found defects counted that way, in percent (D-110).
  flatSharePct       Float?
  capturedAt         DateTime   @default(now())
  createdAt          DateTime   @default(now())

  roll        Roll        @relation(fields: [rollId], references: [id], onDelete: Restrict)
  deviceToken ApiToken?   @relation(fields: [deviceTokenId], references: [id], onDelete: SetNull)
  detections  Detection[]

  @@unique([rollId, sequence])
  @@index([createdAt])
  @@index([finalVerdict])
  @@index([deviceTokenId])
  @@map("scans")
}

model Detection {
  id           String  @id @default(uuid(7)) @db.Uuid
  scanId       String  @db.Uuid
  defectTypeId String? @db.Uuid // always set since D-108; nullable for old rows
  rawClassKey  String // exactly what the model sent
  confidence   Float
  x            Float // bounding box, fractions 0–1 of the image
  y            Float
  width        Float
  height       Float
  /// The box diagonal and box area in inches (Phase 30C, D-106); null without a calibration.
  lengthIn     Float?
  areaSqIn     Float?

  scan       Scan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  defectType DefectType? @relation(fields: [defectTypeId], references: [id])

  @@index([scanId])
  @@index([defectTypeId])
  @@map("detections")
}

// ───────────── inventory ─────────────
model InventoryItem {
  id             String            @id @default(uuid(7)) @db.Uuid
  sku            String            @unique
  name           String
  category       InventoryCategory
  unit           String // "roll", "box", "kg", "m"
  quantityOnHand Decimal           @default(0) @db.Decimal(12, 2) // changed only via movements
  reorderLevel   Decimal           @default(0) @db.Decimal(12, 2)
  /// The leather roll's supplier (Phase 29, D-102); required for LEATHER_ROLL, null otherwise.
  supplierId     String?           @db.Uuid
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  supplier  Supplier?           @relation(fields: [supplierId], references: [id])
  movements InventoryMovement[]
  /// A leather roll item's rolls, one record each (Phase 30A, D-104)
  rolls     Roll[]

  @@index([category, isActive])
  @@index([supplierId])
  @@map("inventory_items")
}

model InventoryMovement {
  id            String       @id @default(uuid(7)) @db.Uuid
  itemId        String       @db.Uuid
  type          MovementType
  quantityDelta Decimal      @db.Decimal(12, 2) // + for IN, - for OUT, either sign for ADJUST
  reason        String
  rollId        String?      @map("batchId") @db.Uuid
  /// The Update stock save this entry came from (Phase 29); null for older entries.
  updateId      String?      @db.Uuid
  createdById   String       @db.Uuid
  createdAt     DateTime     @default(now())

  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  roll      Roll?         @relation(fields: [rollId], references: [id])
  update    StockUpdate?  @relation(fields: [updateId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])

  @@index([itemId, createdAt])
  @@index([rollId])
  @@index([updateId])
  @@index([createdById])
  @@index([type, createdAt])
  @@map("inventory_movements")
}

/// One save of the Update stock sheet (Phase 29, D-102): what was added (+), used (−) or
/// corrected, per item, as ledger movements. A save on a reminder day clears the reminder.
model StockUpdate {
  id          String   @id @default(uuid(7)) @db.Uuid
  day         DateTime @db.Date // the Manila calendar date
  createdById String   @db.Uuid
  note        String?
  createdAt   DateTime @default(now())

  createdBy User                @relation(fields: [createdById], references: [id])
  movements InventoryMovement[]

  @@index([day])
  @@index([createdById])
  @@map("stock_updates")
}

/// Single row: the days the Floor Manager is reminded to update stock (Phase 29, C-32).
model InventorySettings {
  id           Int      @id @default(1)
  /// ISO weekdays, Monday (1) to Friday (5) since D-105; default Wednesday and Friday.
  reminderDays Int[]    @default([3, 5])
  updatedById  String?  @db.Uuid
  updatedAt    DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("inventory_settings")
}

// ───────────── attendance (Phase 22, D-077 to D-081) ─────────────

/// One day's attendance: a log book, never a score (D-008, D-077). A row exists only once the
/// Floor Manager saved that day; `takenBy` and `takenAt` are the last save, the audit log has all.
model AttendanceDay {
  id        String   @id @default(uuid(7)) @db.Uuid
  day       DateTime @unique @db.Date // the Manila calendar date
  takenById String   @db.Uuid
  takenAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  takenBy User             @relation("AttendanceTakenBy", fields: [takenById], references: [id])
  marks   AttendanceMark[]

  @@index([takenById])
  @@map("attendance_days")
}

/// Present or absent for one person on one day. One row per person on the roster when the day
/// was saved; re-saving the day replaces them.
model AttendanceMark {
  id              String  @id @default(uuid(7)) @db.Uuid
  attendanceDayId String  @db.Uuid
  userId          String  @db.Uuid
  present         Boolean

  attendanceDay AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Restrict)
  // The app never deletes a user (it deactivates them, D-024); only tests and demo:reset do, and
  // then the marks naming them go too, so a cleanup is never blocked by a saved day.
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([attendanceDayId, userId])
  @@index([userId])
  @@map("attendance_marks")
}

/// When each batch ends (D-083, D-097): a batch is one check-in interval of the working day. The
/// row in force on a day is the latest effectiveFrom on or before it; a change applies from the
/// next day.
/// The lunch break that pauses a batch (D-097, C-3, C-25, C-40), set by the System Admin. The same
/// on every working day; both times null = no lunch break. Applies from the next day.
model LunchBreak {
  id            String   @id @default(uuid(7)) @db.Uuid
  startTime     String? // "HH:mm", Manila
  endTime       String? // "HH:mm", Manila
  effectiveFrom DateTime @db.Date
  createdById   String?  @db.Uuid // null for the bootstrap default
  createdAt     DateTime @default(now())

  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([effectiveFrom])
  @@index([createdById])
  @@map("lunch_breaks")
}

/// Pairs per day for the whole line (D-085, D-099, C-30): one number, counted on passed pairs
/// (C-41). Never per person (D-008).
/// A day's plan (Phase 30E-2, D-114): the Floor Manager plans each working day on the calendar,
/// or marks it Non-working / Holiday. A day with no row has no batches. Old schedules and quotas
/// became one row per past working day in the migration `day_plans` (no author, no rolls).
model DayPlan {
  id              String   @id @default(uuid(7)) @db.Uuid
  day             DateTime @unique @db.Date // the Manila calendar date
  kind            DayKind
  /// Rolls to be used, an estimate (constructors may start more); null on converted days.
  rollsPlanned    Int?
  /// Pairs that pass inspection, for the whole line (C-41).
  quota           Int?
  /// What the page suggested when the quota was set.
  suggestedQuota  Int?
  /// 240 or null (once at the end of the day, D-115); converted days may hold 60 to 180.
  intervalMinutes Int?
  shiftStart      String? // "HH:mm", Manila; null when Non-working
  shiftEnd        String?
  createdById     String?  @db.Uuid // null when converted
  updatedById     String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User? @relation("DayPlanCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("DayPlanUpdatedBy", fields: [updatedById], references: [id])

  @@index([createdById])
  @@index([updatedById])
  @@map("day_plans")
}

/// A finished batch (D-084, D-098): the pairs finished in it and how many of them failed
/// inspection (C-27). `slotAt` is the batch's end. One row per batch.
model ProductionCheckIn {
  id                   String    @id @default(uuid(7)) @db.Uuid
  day                  DateTime  @db.Date // the Manila calendar date
  slotAt               DateTime // the batch's end
  enteredAt            DateTime  @default(now())
  enteredById          String    @db.Uuid
  pairs                Int
  failedPairs          Int       @default(0)
  /// Shoe Constructors present when it was saved; null = attendance not taken (D-080).
  constructorsPresent  Int?
  constructorsOnRoster Int?
  notes                String?
  correctedAt          DateTime?
  correctedById        String?   @db.Uuid
  correctionReason     String?
  updatedAt            DateTime  @updatedAt

  enteredBy   User                @relation("CheckInEnteredBy", fields: [enteredById], references: [id])
  correctedBy User?               @relation("CheckInCorrectedBy", fields: [correctedById], references: [id])
  /// Rolls ticked Fully used when this batch was finished or corrected (Phase 30A)
  rollsUsed   Roll[]
  /// The queued batch this finish inspected (Phase 33, D-129); null only before its row is made.
  batchId     String?             @unique @db.Uuid
  batch       ProductionBatch?    @relation(fields: [batchId], references: [id])
  /// What was wrong with the failed pairs (Phase 34, D-130); empty before Phase 34.
  findings    InspectionFinding[]

  @@unique([day, slotAt])
  @@index([enteredById])
  @@index([correctedById])
  @@map("production_check_ins")
}

/// One batch of a working day with its code, B-YYMMDD-N (Phase 33, D-129, A-57), made from the
/// day's plan. It waits in the Inspection queue from its end until inspected or voided.
model ProductionBatch {
  id                    String        @id @default(uuid(7)) @db.Uuid
  code                  String        @unique
  day                   DateTime      @db.Date // the Manila calendar date
  number                Int
  startAt               DateTime
  slotAt                DateTime // the batch's end
  status                BatchStatus   @default(OPEN)
  priority              BatchPriority @default(NORMAL)
  priorityReason        String?
  prioritySetAt         DateTime?
  prioritySetById       String?       @db.Uuid
  inspectionStartedAt   DateTime?
  inspectionStartedById String?       @db.Uuid
  voidReason            String?
  voidedAt              DateTime?
  /// Null when the system voided it ("from before the queue", A-61).
  voidedById            String?       @db.Uuid
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  inspectionStartedBy User?              @relation("BatchInspectionStartedBy", fields: [inspectionStartedById], references: [id])
  prioritySetBy       User?              @relation("BatchPrioritySetBy", fields: [prioritySetById], references: [id])
  voidedBy            User?              @relation("BatchVoidedBy", fields: [voidedById], references: [id])
  checkIn             ProductionCheckIn?
  stageCounts         StageCount[]

  @@unique([day, slotAt])
  @@index([status, priority])
  @@index([inspectionStartedById])
  @@index([prioritySetById])
  @@index([voidedById])
  @@map("production_batches")
}

/// When the Inspection queue began (Phase 33, A-61): a batch that ended before it and was never
/// inspected is Void, "Not inspected, from before the queue". One row; none = every batch queues.
model InspectionQueueStart {
  id        Int      @id @default(1)
  startedAt DateTime

  @@map("inspection_queue_start")
}

/// The defects found on finished shoes (Phase 34, D-130, A-62): data the System Admin sets, a
/// separate list from the camera's leather DefectTypes. OTHER always exists and needs a note.
model FinalDefectType {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  label       String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  findings InspectionFinding[]

  @@map("final_defect_types")
}

/// One line of "what was wrong": pairs of a failed batch with one defect, and the QI's call
/// (Phase 34, D-130). `returnStage` is where a Fixable pair goes back to (A-75); a Not fixable
/// pair is scrapped and has none.
model InspectionFinding {
  id                String           @id @default(uuid(7)) @db.Uuid
  checkInId         String           @db.Uuid
  finalDefectTypeId String           @db.Uuid
  pairs             Int
  remedy            Remedy
  returnStage       ProductionStage?
  note              String?
  createdAt         DateTime         @default(now())

  checkIn         ProductionCheckIn @relation(fields: [checkInId], references: [id])
  finalDefectType FinalDefectType   @relation(fields: [finalDefectTypeId], references: [id])
  repairJobs      RepairJob[]

  @@index([checkInId])
  @@index([finalDefectTypeId, createdAt])
  @@map("inspection_findings")
}

/// Fixable pairs sent back to a stage (Phase 34, D-130). `code` is RP-<yymmdd>-<batch no>-<seq>.
model RepairJob {
  id            String          @id @default(uuid(7)) @db.Uuid
  code          String          @unique
  findingId     String          @db.Uuid
  /// The job this one was sent back again from (A-88).
  parentId      String?         @db.Uuid
  pairs         Int
  stage         ProductionStage
  status        RepairStatus    @default(AT_STAGE)
  sentAt        DateTime
  backAt        DateTime?
  backById      String?         @db.Uuid
  inspectedAt   DateTime?
  inspectedById String?         @db.Uuid
  passedPairs   Int?
  scrappedPairs Int?
  resentPairs   Int?
  changeReason  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  finding     InspectionFinding @relation(fields: [findingId], references: [id])
  parent      RepairJob?        @relation("RepairResent", fields: [parentId], references: [id])
  children    RepairJob[]       @relation("RepairResent")
  backBy      User?             @relation("RepairBackBy", fields: [backById], references: [id])
  inspectedBy User?             @relation("RepairInspectedBy", fields: [inspectedById], references: [id])

  @@index([status, stage])
  @@index([findingId])
  @@index([parentId])
  @@index([backById])
  @@index([inspectedById])
  @@map("repair_jobs")
}

/// Who works at which stage on a day (Phase 34, D-130, A-86): the Floor Manager's assignment, not
/// a score. A constructor is at one stage a day.
model StageAssignment {
  id           String          @id @default(uuid(7)) @db.Uuid
  day          DateTime        @db.Date // the Manila calendar date
  stage        ProductionStage
  userId       String          @db.Uuid
  assignedById String          @db.Uuid
  createdAt    DateTime        @default(now())

  user       User @relation("StageAssignee", fields: [userId], references: [id])
  assignedBy User @relation("StageAssignedBy", fields: [assignedById], references: [id])

  @@unique([day, userId])
  @@index([day, stage])
  @@index([assignedById])
  @@map("stage_assignments")
}

/// Pairs at a stage now (Phase 34, D-130, A-72, A-73): one shared snapshot per stage, appended on
/// every save; the latest row of a day and stage is the current count. Never per person.
model StageCount {
  id          String          @id @default(uuid(7)) @db.Uuid
  day         DateTime        @db.Date
  stage       ProductionStage
  pairs       Int
  enteredById String          @db.Uuid
  enteredAt   DateTime        @default(now())
  batchId     String?         @db.Uuid

  enteredBy User             @relation("StageCountBy", fields: [enteredById], references: [id])
  batch     ProductionBatch? @relation(fields: [batchId], references: [id])

  @@index([day, stage, enteredAt])
  @@index([enteredById])
  @@index([batchId])
  @@map("stage_counts")
}

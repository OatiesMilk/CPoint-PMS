# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# generated
/src/generated/prisma

# testing
/coverage
/playwright-report
/test-results
/blob-report

# runtime data
/storage

# Codex QA screenshots and logs (the reports themselves are committed)
/qa/reports/artifacts/

# env files (.env.example is committed)
.env
.env.*
!.env.example

# HTTPS certificate and key for the LAN (mkcert, D-065): never committed
/certs/*
!/certs/.gitkeep

# misc
.DS_Store
Thumbs.db
*.pem
*.log
/.idea
/.vscode
/.zed

# tool-installed agent skills (keep only the curated ones in .claude/skills)
/.agents
/.windsurf
skills-lock.json

# camera station (cv/): model files, local config, outputs and Python caches (D-049)
*.pt
*.onnx
/cv/models/*
!/cv/models/.gitkeep
/cv/config.toml
# the station window's last camera choice (D-062)
/cv/station-window.json
/cv/out/
/cv/.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

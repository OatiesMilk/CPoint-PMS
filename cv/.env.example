# Camera station secrets. Copy to cv/.env (git-ignored). Variables set in the shell win over this file.

# The device token (scope scans:create). The System Admin creates it under API tokens, or run
# `npm run cv:token` from the repo root. Never commit it; the station never prints or logs it.
CV_DEVICE_TOKEN=

# The app's address, when it isn't [server] base_url in cv/config.toml (http://localhost:3000).
# CV_BASE_URL=http://localhost:3001
